#!/usr/bin/env node
/**
 * moku-rails: the strict layer under the conversational conductor.
 *
 * Exit codes: 0 allowed or done, 1 usage or runtime error, 2 the rails refuse this move.
 * Thin entry: parse arguments, dispatch to a handler, print the result.
 */

import * as commands from "../lib/rails/commands.mjs";

const HANDLERS = {
  status: commands.status,
  open: commands.open,
  enter: commands.enter,
  done: commands.done,
  skip: commands.skip,
  check: commands.check,
  close: commands.close,
  pause: commands.pause,
  park: commands.park,
  resume: commands.resume,
  idea: commands.idea,
  init: commands.init,
  guard: commands.guard,
  "guard-bash": commands.guardBash,
  "may-stop": commands.mayStop,
};

const [name, ...rest] = process.argv.slice(2);
const handler = HANDLERS[name];

// Unknown command: list what exists
if (!handler) {
  console.error(`Usage: moku-rails <${Object.keys(HANDLERS).join("|")}> [args] [--json]`);
  process.exit(1);
}

// Run the handler; a thrown error is a plain failure, never a refusal
const args = parse(rest);
let result;
try {
  result = handler(args);
} catch (error) {
  result = { code: 1, lines: [error instanceof Error ? error.message : String(error)] };
}

// Print for humans, or as JSON for skills and hooks
const output = args.flags.json ? JSON.stringify({ code: result.code, lines: result.lines, data: result.data ?? null }) : result.lines.join("\n");
(result.code === 0 ? console.log : console.error)(output);
process.exit(result.code);

/**
 * Split argv into positionals and `--flag value` pairs.
 *
 * @param {string[]} argv
 * @returns {{ root: string, positional: string[], flags: Record<string, string | true> }}
 */
function parse(argv) {
  const positional = [];
  const flags = {};

  for (let index = 0; index < argv.length; index += 1) {
    const token = argv[index];
    if (!token.startsWith("--")) {
      positional.push(token);
      continue;
    }

    const next = argv[index + 1];
    const hasValue = next !== undefined && !next.startsWith("--");
    flags[token.slice(2)] = hasValue ? next : true;
    if (hasValue) index += 1;
  }

  return { root: typeof flags.root === "string" ? flags.root : process.cwd(), positional, flags };
}
